{
  "name": "subcontractor-intelligence",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build && node scripts/finalize-locales.mjs && node scripts/verify-locales.mjs && node scripts/verify-formatting.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "format:check": "prettier --check src scripts *.json README.md",
    "extract-i18n": "ng extract-i18n"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/localize": "21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "overrides": {
    "undici@7.29.0": "7.29.1"
  }
}
